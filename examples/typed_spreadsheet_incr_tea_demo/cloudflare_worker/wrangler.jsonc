{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typed-spreadsheet-cloudflare-worker",
  "main": "./entry.mjs",
  "compatibility_date": "2026-07-24",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "TypedSpreadsheetRoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["TypedSpreadsheetRoomDurableObject"]
    }
  ]
}
